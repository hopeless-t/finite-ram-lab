{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SIG-001-CAL-MANIFEST.schema.json",
  "title": "SIG-001 calibration prediction manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "provider_id",
    "provider_version",
    "decision_rule_id",
    "epoch_id",
    "environment_digest",
    "prediction_horizon_id",
    "predictions_sha256",
    "external_seal_ref"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_id": {"const": "SIG-001-CAL-PROTOCOL-v1"},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_version": {"type": "string", "minLength": 1},
    "decision_rule_id": {"type": "string", "minLength": 1},
    "epoch_id": {"type": "string", "minLength": 1},
    "environment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "prediction_horizon_id": {"type": "string", "minLength": 1},
    "predictions_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "external_seal_ref": {"type": "string", "minLength": 1}
  }
}
