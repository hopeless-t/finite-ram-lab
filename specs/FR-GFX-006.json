  "receipt_fields": [
    "wall_seconds",
    "collector_cpu_seconds",
    "collector_cpu_pct_one_core",
    "collector_peak_observed_rss_kib",
    "jsonl_bytes",
    "bytes_per_sample"
  ],
  "boundary": "Hosted-runner measurements validate harness execution only; they are not transferred as live low-end-game overhead.",
  "claim_ceiling": "RUNNABLE_READ_ONLY_COLLECTOR_HARNESS_ONLY"
