{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EVIDENCE-RESIDENCY-MANIFEST-v1.schema.json",
  "title": "Finite RAM Lab evidence residency manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "run_id",
    "source_commit",
    "created_at_utc",
    "residency_tier",
    "content_set_sha256",
    "file_count",
    "total_bytes",
    "files",
    "storage_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "evidence-residency-v1"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "residency_tier": {
      "enum": ["HOT", "WARM", "COLD"]
    },
    "content_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "storage_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "provider", "locator"],
        "properties": {
          "tier": {
            "enum": ["HOT", "WARM", "COLD"]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "origin": {
      "type": "object"
    }
  }
}
