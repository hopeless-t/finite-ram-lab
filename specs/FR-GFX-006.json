  "title": "FR-GFX-006 Read-only Procfs Collector",
  "status": "RUNNABLE_READ_ONLY_COLLECTOR",
  "parent": "FR-GFX-005",
  "inputs": [
    "/proc/meminfo",
    "/proc/pressure/memory",
