{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TRANSACTION-RECEIPT-PACKET-v1.schema.json",
  "title": "Finite RAM transactional receipt packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "epoch",
    "phase",
    "touch",
    "trace_complete",
    "cpu_match",
    "worker_ok",
    "vmpte_delta_kib",
    "page_counter_try_charge_64_count",
    "refill_stock_63_count",
    "drain_stock_count",
    "classified_release_only_count"
  ],
  "properties": {
    "schema_version": {"const": "transaction-receipt-packet-v1"},
    "epoch": {"type": "integer", "minimum": 0},
    "phase": {"enum": ["NORMALIZE", "CONSUME", "TARGET"]},
    "touch": {"type": "integer", "minimum": 0},
    "trace_complete": {"type": "boolean"},
    "cpu_match": {"type": "boolean"},
    "worker_ok": {"type": "boolean"},
    "vmpte_delta_kib": {"type": "integer"},
    "page_counter_try_charge_64_count": {"type": "integer", "minimum": 0},
    "refill_stock_63_count": {"type": "integer", "minimum": 0},
    "drain_stock_count": {"type": "integer", "minimum": 0},
    "classified_release_only_count": {"type": "integer", "minimum": 0},
    "target_match": {"type": ["boolean", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
